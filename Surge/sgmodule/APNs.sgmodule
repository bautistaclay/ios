#!name=苹果APNs推送
#!desc=设置完之后要开关飞行模式，断掉所有连接才会生效,如果还是不行可以尝试到设置，隧道，打开包含所有网络，apns开关
#!category= ⚙️ ▸ 功能增强
#!author=ttyyss2233
#!arguments-desc=[参数说明]\n\n⓵ 若使用提示未知策略组，\n请修改配置项或者添加策略组。\n\n⓶ 在对应策略组配置项内，\n填写你所使用的策略组或内置策略。\n\n⓷ 若配置项不填写，则默认为PROXY策略。
#!arguments=代理策略组:PROXY



[Rule]
DOMAIN-SUFFIX,push.apple.com,{{{代理策略组}}}
DOMAIN-SUFFIX,akadns.net,{{{代理策略组}}}
DOMAIN-KEYWORD,apple.com.edgekey.net,{{{代理策略组}}}

IP-CIDR,17.249.0.0/16,{{{代理策略组}}},no-resolve
IP-CIDR,17.252.0.0/16,{{{代理策略组}}},no-resolve
IP-CIDR,17.57.144.0/22,{{{代理策略组}}},no-resolve
IP-CIDR,17.188.128.0/18,{{{代理策略组}}},no-resolve
IP-CIDR,17.188.20.0/23,{{{代理策略组}}},no-resolve

IP-CIDR6,2620:149:a44::/48,{{{代理策略组}}},no-resolve
IP-CIDR6,2403:300:a42::/48,{{{代理策略组}}},no-resolve
IP-CIDR6,2403:300:a51::/48,{{{代理策略组}}},no-resolve
IP-CIDR6,2a01:b740:a42::/48,{{{代理策略组}}},no-resolve